# ── QueryPilot Environment Configuration ──
# Copy to .env and edit values. Never commit .env to version control.

# ── Database (owner/app role) ──
DATABASE_URL=postgresql+psycopg://querypilot:querypilot_dev@localhost:5432/querypilot

# ── Database (read-only role for generated SQL) ──
READONLY_DATABASE_URL=postgresql+psycopg://querypilot_ro:querypilot_ro_dev@localhost:5432/querypilot

# ── Postgres container settings ──
POSTGRES_USER=querypilot
POSTGRES_PASSWORD=querypilot_dev
POSTGRES_DB=querypilot

# ── LLM Provider ──
LLM_PROVIDER=openai          # openai | anthropic
LLM_MODEL=gpt-4o-mini        # model name for the chosen provider
LLM_API_KEY=your-api-key-here
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30

# ── Application mode ──
MOCK_MODE=true                # true = deterministic mock, no API key needed

# ── Safety and limits ──
MAX_SQL_RETRIES=2
MAX_CLARIFICATION_ROUNDS=3
MAX_RESULT_ROWS=100
SQL_STATEMENT_TIMEOUT_MS=5000

# ── Logging ──
LOG_LEVEL=INFO
